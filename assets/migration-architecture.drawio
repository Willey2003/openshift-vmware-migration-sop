<mxfile host="drawio" type="device"><diagram id="mig" name="Migration architecture"><mxGraphModel dx="1700" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1080" background="#f6f4ef" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="kicker" value="THE LAB MANUAL · MIGRATION EDITION" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#b8231d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="900" height="20" as="geometry"/></mxCell><mxCell id="title" value="VMware vSphere to OpenShift Virtualization: migration architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontColor=#1d1f22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1300" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="What talks to what when MTV moves one VM. Lab-validated on OpenShift 4.22.15, OpenShift Virtualization 4.22.9, MTV 2.12.9 and vSphere 8." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#5f6670;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="94" width="1500" height="22" as="geometry"/></mxCell><mxCell id="src" value="1 · Source: VMware vSphere 8" style="swimlane;rounded=1;arcSize=2;startSize=40;html=1;fillColor=#1d1f22;swimlaneFillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;align=left;spacingLeft=14;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="380" height="640" as="geometry"/></mxCell><mxCell id="vc" value="&lt;b&gt;vCenter Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;inventory, credentials, HTTPS 443&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=1.5;fontColor=#1d1f22;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="196" width="332" height="70" as="geometry"/></mxCell><mxCell id="esxi" value="&lt;b&gt;ESXi hosts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;serve the disks: NBD 902 (with VDDK)&lt;/font&gt;" style="rounded=1;arcSize=11;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=1.5;fontColor=#1d1f22;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="286" width="332" height="70" as="geometry"/></mxCell><mxCell id="vm" value="&lt;b&gt;VM: ubuntu-noble-24.04&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;Ubuntu 24.04 · 2 vCPU · 1 GiB · BIOS&lt;br&gt;MAC 00:50:56:aa:00:01&lt;br&gt;VMware Tools&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=1.5;fontColor=#1d1f22;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="376" width="332" height="116" as="geometry"/></mxCell><mxCell id="vmdk" value="&lt;b&gt;VMDK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;10 GiB disk&lt;br&gt;on DATASTORE-01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1efea;strokeColor=#c9c4ba;strokeWidth=1.5;fontColor=#1d1f22;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="512" width="160" height="92" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;Port group&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;VM-Network-110&lt;br&gt;VLAN 110&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1efea;strokeColor=#c9c4ba;strokeWidth=1.5;fontColor=#1d1f22;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="236" y="512" width="160" height="92" as="geometry"/></mxCell><mxCell id="srcnote" value="&lt;b&gt;Read path decides speed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;No VDDK: disks read over HTTPS via&lt;br&gt;vCenter (443). Lab: ~2.8 MB/s.&lt;br&gt;With VDDK: NBD from ESXi (902),&lt;br&gt;much faster. Build it before wave 1.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbf2e2;strokeColor=#a0640b;strokeWidth=1.5;fontColor=#a0640b;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="64" y="624" width="332" height="132" as="geometry"/></mxCell><mxCell id="ocp" value="2 · Target: OpenShift 4.22 compact cluster (3 nodes, control plane + workers)" style="swimlane;rounded=1;arcSize=2;startSize=40;html=1;fillColor=#1d1f22;swimlaneFillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;align=left;spacingLeft=14;container=0;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="1190" height="640" as="geometry"/></mxCell><mxCell id="mtv" value="Namespace openshift-mtv · MTV 2.12" style="swimlane;rounded=1;arcSize=2;startSize=40;html=1;fillColor=#b8231d;swimlaneFillColor=#fffdfb;strokeColor=#b8231d;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;align=left;spacingLeft=14;container=0;" vertex="1" parent="1"><mxGeometry x="494" y="192" width="520" height="380" as="geometry"/></mxCell><mxCell id="prov" value="&lt;b&gt;Provider&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;vcenter-lab&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#fbeceb;strokeColor=#b8231d;strokeWidth=1.5;fontColor=#1d1f22;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="246" width="150" height="60" as="geometry"/></mxCell><mxCell id="nmap" value="&lt;b&gt;NetworkMap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;PG → NAD&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#fbeceb;strokeColor=#b8231d;strokeWidth=1.5;fontColor=#1d1f22;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="678" y="246" width="150" height="60" as="geometry"/></mxCell><mxCell id="smap" value="&lt;b&gt;StorageMap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;datastore → nfs-csi&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#fbeceb;strokeColor=#b8231d;strokeWidth=1.5;fontColor=#1d1f22;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="842" y="246" width="152" height="60" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;Plan: test-ubuntu (cold)&lt;/b&gt;" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#fbeceb;strokeColor=#b8231d;strokeWidth=1.5;fontColor=#1d1f22;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="320" width="316" height="46" as="geometry"/></mxCell><mxCell id="mig" value="&lt;b&gt;Migration&lt;/b&gt;" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#fbeceb;strokeColor=#b8231d;strokeWidth=1.5;fontColor=#1d1f22;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="842" y="320" width="152" height="46" as="geometry"/></mxCell><mxCell id="pipeh" value="Pipeline (one run of the Migration):" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5f6670;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="514" y="380" width="480" height="20" as="geometry"/></mxCell><mxCell id="st0" value="1. Initialize  ·  validate, find the VM" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#f1efea;strokeColor=#c9c4ba;strokeWidth=1.5;fontColor=#1d1f22;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="404" width="480" height="28" as="geometry"/></mxCell><mxCell id="st1" value="2. DiskAllocation  ·  create the target PVC" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#f1efea;strokeColor=#c9c4ba;strokeWidth=1.5;fontColor=#1d1f22;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="436" width="480" height="28" as="geometry"/></mxCell><mxCell id="st2" value="3. ImageConversion  ·  virt-v2v: virtio + guest agent" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#fbeceb;strokeColor=#b8231d;strokeWidth=1.5;fontColor=#1d1f22;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="468" width="480" height="28" as="geometry"/></mxCell><mxCell id="st3" value="4. DiskTransfer  ·  copy blocks into the PVC" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#f1efea;strokeColor=#c9c4ba;strokeWidth=1.5;fontColor=#1d1f22;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="500" width="480" height="28" as="geometry"/></mxCell><mxCell id="st4" value="5. VirtualMachineCreation  ·  same CPU, RAM, MAC" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;fillColor=#f1efea;strokeColor=#c9c4ba;strokeWidth=1.5;fontColor=#1d1f22;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="532" width="480" height="28" as="geometry"/></mxCell><mxCell id="cnv" value="Namespace mtv-test · OpenShift Virtualization 4.22" style="swimlane;rounded=1;arcSize=2;startSize=40;html=1;fillColor=#1d1f22;swimlaneFillColor=#fbfaf7;strokeColor=#1d1f22;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;align=left;spacingLeft=14;container=0;" vertex="1" parent="1"><mxGeometry x="1040" y="192" width="600" height="380" as="geometry"/></mxCell><mxCell id="vmo" value="&lt;b&gt;VirtualMachine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;ubuntu-noble-24.04-cloudimg&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=1.5;fontColor=#1d1f22;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1064" y="246" width="270" height="60" as="geometry"/></mxCell><mxCell id="vmi" value="&lt;b&gt;VirtualMachineInstance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;the running VM&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=1.5;fontColor=#1d1f22;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1352" y="246" width="264" height="60" as="geometry"/></mxCell><mxCell id="pod" value="&lt;b&gt;virt-launcher Pod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;QEMU/KVM runs the guest inside a Pod on a node with /dev/kvm.&lt;br&gt;Kept from the source: MAC, disk serial, BIOS serial, CPU layout&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d1f22;strokeWidth=1.5;fontColor=#1d1f22;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1064" y="326" width="552" height="76" as="geometry"/></mxCell><mxCell id="pvc" value="&lt;b&gt;PVC (the disk)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;StorageClass nfs-csi&lt;br&gt;Access mode RWX&lt;br&gt;→ live migration between nodes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f5ee;strokeColor=#2f7d4f;strokeWidth=1.5;fontColor=#2f7d4f;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1064" y="422" width="270" height="130" as="geometry"/></mxCell><mxCell id="nad" value="&lt;b&gt;NAD: default/vlan-110&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;NetworkAttachmentDefinition&lt;br&gt;bridge br-vm, VLAN 110&lt;br&gt;= the new port group&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eaf2f9;strokeColor=#2d6a9f;strokeWidth=1.5;fontColor=#2d6a9f;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1352" y="422" width="264" height="130" as="geometry"/></mxCell><mxCell id="nodes" value="Every node (ocp-node-1..3)" style="swimlane;rounded=1;arcSize=2;startSize=40;html=1;fillColor=#5f6670;swimlaneFillColor=#f6f4ef;strokeColor=#c9c4ba;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=17;align=left;spacingLeft=14;container=0;" vertex="1" parent="1"><mxGeometry x="494" y="594" width="1146" height="162" as="geometry"/></mxCell><mxCell id="csi" value="&lt;b&gt;CSI driver nfs.csi.k8s.io&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;csi-driver-nfs v4.11.0&lt;br&gt;provisions a subdirectory per PVC&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#e9f5ee;strokeColor=#2f7d4f;strokeWidth=1.5;fontColor=#2f7d4f;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="514" y="648" width="300" height="88" as="geometry"/></mxCell><mxCell id="cdi" value="&lt;b&gt;Conversion + import Pods&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;virt-v2v, CDI importer&lt;br&gt;short-lived, one per migration&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#fbeceb;strokeColor=#b8231d;strokeWidth=1.5;fontColor=#b8231d;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="832" y="648" width="300" height="88" as="geometry"/></mxCell><mxCell id="nncp" value="&lt;b&gt;NMState NNCP: linux bridge br-vm on ens34&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5f6670&quot;&gt;ens34 is a VLAN trunk; VLAN filtering on the bridge&lt;br&gt;ens33 stays the node network (VLAN 100)&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#eaf2f9;strokeColor=#2d6a9f;strokeWidth=1.5;fontColor=#2d6a9f;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1150" y="648" width="470" height="88" as="geometry"/></mxCell><mxCell id="nfs" value="&lt;b&gt;NFS server (bastion, RHEL 10)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;export /exports/ocp on a dedicated 500 GB disk&lt;br&gt;backs StorageClass nfs-csi (RWX)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e9f5ee;strokeColor=#2f7d4f;strokeWidth=1.5;fontColor=#2f7d4f;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="520" height="96" as="geometry"/></mxCell><mxCell id="net" value="&lt;b&gt;Physical / distributed switch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#5f6670&quot;&gt;VLAN 100 node network · VLAN 110, 120, 130 VM networks&lt;br&gt;trunk port group to NIC2 of each node VM&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eaf2f9;strokeColor=#2d6a9f;strokeWidth=1.5;fontColor=#2d6a9f;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="820" width="520" height="96" as="geometry"/></mxCell><mxCell id="dns" value="&lt;b&gt;DNS + NTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; 